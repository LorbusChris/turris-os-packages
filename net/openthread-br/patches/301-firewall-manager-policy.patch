+
+    FirewallManager fw(mock, "wpan0");
+    ASSERT_EQ(fw.Init(), OTBR_ERROR_NONE);
+    EXPECT_EQ(fw.Deinit(), OTBR_ERROR_NONE);
+    EXPECT_FALSE(fw.IsInitialized());
+}
