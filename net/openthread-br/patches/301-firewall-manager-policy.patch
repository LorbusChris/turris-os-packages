+TEST(FirewallManagerTest, InitTwiceFails)
+{
+    NiceMock<MockNftables> mock;
+    SetSuccessfulDefaults(mock);
+
+    FirewallManager fw(mock, "wpan0");
+    ASSERT_EQ(fw.Init(), OTBR_ERROR_NONE);
+    EXPECT_EQ(fw.Init(), OTBR_ERROR_INVALID_STATE);
+}
